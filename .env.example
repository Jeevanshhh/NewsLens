# ============================================================
# NewsLens / News Intelligence Platform - environment template
# ------------------------------------------------------------
# Copy this file to `.env` and fill in real values.
#   - `.env` is git-ignored and must NEVER be committed.
#   - NEVER put real API keys in source code or the frontend.
#   - The keys previously hard-coded in the notebook are
#     considered COMPROMISED: rotate/revoke them at the
#     provider dashboards and paste the NEW ones here.
# ============================================================

# ---- News provider API keys (placeholders only) ----
GNEWS_API_KEY=your_gnews_api_key_here
NEWSDATA_API_KEY=your_newsdata_api_key_here

# Google News RSS requires no API key.

# ---- Backend / app ----
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Auth / JWT (generate a long random string for production)
# In production (APP_ENV=production) the app REFUSES to boot while SECRET_KEY
# is still the default value, or while CORS_ORIGINS is wildcard/localhost-only.
SECRET_KEY=change_me_to_a_long_random_secret
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---- Account lifecycle / brute-force protection ----
# Password-reset links expire after this many minutes.
PASSWORD_RESET_EXPIRE_MINUTES=30
# Sliding-window login rate limit (per client host + email).
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_SECONDS=300
# Reject request bodies larger than this many bytes (defence-in-depth).
MAX_BODY_BYTES=1000000

# ---- Outbound email (password-reset links) ----
# If SMTP_HOST/SMTP_FROM are empty, reset emails are NOT sent and NOT faked:
# they are captured in an in-memory outbox for development only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true
# Absolute URL of the web app, used to build reset links in emails.
PUBLIC_FRONTEND_URL=http://localhost:5173

# ---- Observability ----
# Emit structured JSON logs (forced on automatically when APP_ENV=production).
LOG_JSON=false
# Optional error-monitoring sink (e.g. Sentry). Empty => disabled.
SENTRY_DSN=

# ---- Database ----
# SQLite for local dev; switch to PostgreSQL for production.
DATABASE_URL=sqlite:///./newslens.db
# PostgreSQL example - note the RUNTIME app connects as a NON-owner role so
# Row-Level Security actually binds it (a table owner would bypass RLS):
# DATABASE_URL=postgresql+psycopg://newslens_app:APP_DB_PASSWORD@localhost:5432/newslens
#
# Migrations need DDL + table-owner rights, so they run as a SEPARATE admin/
# owner role. When ALEMBIC_DATABASE_URL is unset, Alembic falls back to
# DATABASE_URL (fine for single-role/dev); set it in production Postgres:
# ALEMBIC_DATABASE_URL=postgresql+psycopg://newslens_owner:OWNER_PASSWORD@localhost:5432/newslens
#
# Name of the non-owner runtime role the RLS migration grants privileges to.
# The role itself is provisioned out-of-band (docker-entrypoint / ops runbook),
# NEVER with a password committed here. See docker-compose.yml + the init script.
# RLS_APP_ROLE=newslens_app


# ---- Collection defaults (non-secret tuning) ----
MAX_RESULTS=10
REQUEST_DELAY=1
RSS_COUNTRY=IN
RSS_LANGUAGE=en

# ---- Classification ----
# Supervised topic-model fallback for unclassified articles.
# Deterministic offline tests set this to false to keep counts stable.
ENABLE_TOPIC_MODEL=true
