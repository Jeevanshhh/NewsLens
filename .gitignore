# ---- Environment / secrets ----
.env
.env.*
!.env.example

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---- Databases (dev SQLite) ----
*.sqlite
*.sqlite3
*.db

# ---- Node / frontend ----
node_modules/
frontend/dist/
frontend/build/
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---- Reports / exports / data ----
# Artifact directories/output files only. The real source package
# backend/app/services/exports/ must stay tracked (Render image imports it),
# so it is explicitly un-ignored here - narrowest possible exception.
exports/
!backend/app/services/exports/
reports/
*.csv
*.xlsx
*.pdf
*.docx
!docs/**/*.csv

# ---- Google service account keys ----
credentials.json
service-account*.json
secrets/

# ---- Editors / OS ----
.vscode/
.idea/
.DS_Store
Thumbs.db

# ---- Logs ----
*.log
logs/

# ---- Local PostgreSQL / test / diagnostic artifacts (never commit) ----
*.pid
pgpass.conf
.pgpass
*_results.xml
pg_results.xml
ci_check.db
# Reproducible evidence/runner scripts are intentionally kept tracked;
# transient scratch output under backend/ is not.
backend/_*.txt
backend/_*.log

# ---- Vercel CLI (local auth / build artifacts, never commit) ----
.vercel/
.vercel-tmp/

# ---- Local exploratory notebooks (not part of the NewsLens app) ----
/CJP Protest News Scraping.ipynb
*.ipynb_checkpoints/

# ---- ML development artifacts (RIGHTS-UNVERIFIED article text: never commit) ----
# Only reusable code/config is tracked; every data/model/report artifact that
# embeds publisher article text or a trained classifier is excluded per Phase 18.
backend/ml/datasets/
backend/ml/models/
backend/ml/reports/
backend/ml/splits/
*.jsonl
*.joblib
